# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS allowlist).
FRONTEND_URL=http://localhost:5173

# ---- MongoDB Atlas ----
MONGODB_URI=

# ---- Auth ----
# Required in production. Minimum 32 characters; generate with `openssl rand -hex 32`.
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-pro
# Hard cap on a single Gemini call (ms).
GEMINI_TIMEOUT_MS=90000

# ---- Google Drive (OAuth2 — desktop-app client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---- Uploads ----
MAX_UPLOAD_MB=15

# ---- Seed (dev only — change before production) ----
SEED_TREASURER_USERNAME=treasurer
SEED_TREASURER_PASSWORD=changeme123
SEED_MEMBER_USERNAME=member
SEED_MEMBER_PASSWORD=changeme123
