# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- MongoDB Atlas ----
MONGODB_URI=

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Google Drive (service account, domain-wide access to a Shared Drive) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---- Uploads ----
MAX_UPLOAD_MB=15

# ---- Seed (dev only — change before production) ----
SEED_TREASURER_USERNAME=treasurer
SEED_TREASURER_PASSWORD=changeme123
SEED_MEMBER_USERNAME=member
SEED_MEMBER_PASSWORD=changeme123
